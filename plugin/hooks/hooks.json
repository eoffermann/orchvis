{
  "description": "orchvis poll-mode assist: surfaces unread orchvis messages from the shim's inbox mirror while the session works.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/inbox-hook.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/inbox-hook.cjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
